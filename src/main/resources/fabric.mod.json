{
  "schemaVersion": 1,
  "id": "nostalgia",
  "version": "${version}",
  "name": "Alpha Protocol",
  "description": "Portals and items transferring you to the simulation of old Minecraft versions.",
  "authors": [
    "gun2rus"
  ],
  "contact": {},
  "license": "CC0-1.0",
  "icon": "assets/nostalgia/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.nostalgia.NostalgiaMod"
    ],
    "client": [
      "net.nostalgia.NostalgiaClient",
      "net.nostalgia.client.render.AlphaRenderLayers"
    ],
    "fabric-datagen": [
      "net.nostalgia.datagen.NostalgiaDataGenerator"
    ]
  },
  "mixins": [
    "nostalgia.mixins.json"
  ],
  "accessWidener": "nostalgia.accesswidener",
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "~1.21.11",
    "java": ">=22",
    "fabric-api": "*",
    "sha": "*",
    "zemlya": "*"
  },
  "recommends": {
    "sodium": ">=0.8.12"
  },
  "suggests": {
    "punchy": "*"
  },
  "breaks": {
    "sodium": "<0.8.12"
  }
}
